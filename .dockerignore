# The store is 75 MB and holds twenty months of watch history no re-scan
# reproduces (docs/baseline.md). It is mounted at runtime, never baked into an
# image, and an image layer carrying it would put that history in every
# registry the image is pushed to.
data/

.env
.venv/
tmp/

# Not the writer: the docs site, the tests. `crates/` stays in the context for the
# Dockerfile's `reader` stage; only its binary reaches the final image.
target/
docs/
tests/
node_modules/

.git/
.github/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
