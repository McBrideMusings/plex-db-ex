# Copy to .env and fill in. .env is gitignored and never committed.

# --- Required: the only hard dependency ---
PLEX_URL=http://<plex-host>:32400
PLEX_TOKEN=<plex-token>

# --- Required: mount roots to strip from a Plex playback path when `plexdb
#     walk` derives a path-based item_id for a title with no recognised
#     external GUID. Comma-separated. `walk` refuses to run while this is
#     empty (issue #24): without it the id is a hash of wherever the disk is
#     mounted, so it matches no other store reading the same Plex server.
#     Set it to the directory the library sections live under — ask Plex for
#     /library/sections and take the common parent of the paths it reports.
PLEX_SOURCE_ROOTS=<media-root>


# --- Required for enrichment: the core acquisition (TMDB keywords) ---
TMDB_API_KEY=<tmdb-api-key>

# --- Optional: days a tmdb_keywords row stays fresh before `plexdb
#     enrich-tmdb-keywords` re-fetches it. Unset means the built-in default
#     of 45 (mid-range of the 30-60 day window docs/schema.md sets for every
#     external source).
TMDB_KEYWORDS_STALE_DAYS=

# --- Optional: days a tmdb_recommendations/tmdb_similar edge set stays fresh
#     before `plexdb enrich-tmdb-edges` re-fetches it. Unset means the
#     built-in default of 45, tracked separately from TMDB_KEYWORDS_STALE_DAYS.
TMDB_EDGES_STALE_DAYS=

# --- Optional: synonym keywords. `plexdb judge-keyword-pairs` embeds stored
#     keywords through llama-swap (`nomic-embed-text`) and asks Jev whether
#     nearby pairs mean the same thing. Either one unset and the sweep skips the
#     step. The container reads its real values from /boot/config/plexdb.env.
LLAMA_SWAP_BASE_URL=<llama-swap-base-url>
TYPESAFE_API_KEY=<typesafe-api-key>

# --- Optional: history adapter. Without these the store still runs, with no
#     abandonment signal and no IP fingerprint tier. See ADR-0004.
TAUTULLI_URL=http://<tautulli-host>:8181
TAUTULLI_API_KEY=<tautulli-api-key>

# --- Optional: Plex account ids `plexdb latent-users` treats as genuinely
#     shared by more than one person, and therefore clusters by device
#     fingerprint. Comma-separated. Every account not listed is reported as
#     one named person, however many devices it shows — device
#     fingerprinting exists only to split apart the accounts named here
#     (issue #27). Unset means the built-in default: 1,3670670
#     (McBrideMusings, bboy2448).
PLEXDB_SHARED_ACCOUNT_IDS=

# --- Optional: additional edge and membership sources ---
# TRAKT_CLIENT_ID is deliberately absent. Trakt deleted existing API
# applications without notice around 1-2 August 2026 and gated new ones behind
# a VIP subscription, so the credential cannot be obtained; issues #12, #14 and
# #36 are closed as not planned. TMDB edges and MDBList collections cover what
# Trakt would have added. Re-add the variable if that restriction lifts.
MDBLIST_API_KEY=<mdblist-api-key>

# --- Optional: days an MDBList collection and its memberships stay fresh
#     before `plexdb harvest-mdblist` re-fetches that list. Unset means the
#     built-in default of 45, tracked separately from the TMDB knobs.
MDBLIST_STALE_DAYS=

# --- Optional: days a title's Wikidata keywords, roles and awards stay fresh
#     before `plexdb enrich-wikidata` asks again. Wikidata needs no key. Unset
#     means the built-in default of 45.
WIKIDATA_STALE_DAYS=

# --- Optional: days an anime title's AniList tags stay fresh before
#     `plexdb enrich-anilist` asks again. AniList needs no key. Unset means the
#     built-in default of 45.
ANILIST_STALE_DAYS=

# --- Optional: an OpenAI-compatible LLM endpoint, used to pull film titles out
#     of editorial prose (issue #37). Point it at a host on the tailnet, never
#     at localhost — localhost only resolves on the box running the service.
#     LLM_API_KEY is unset for a local endpoint that doesn't check one.
LLM_BASE_URL=http://<llm-host>:<port>/v1
LLM_MODEL=<model-name>
LLM_API_KEY=

# --- Where the store lives on this machine. On a dev checkout this is a
#     working copy pulled with `admin pull-baseline`, not the baseline itself.
PLEXDB_PATH=./data/plexdb.db

# --- The baseline store: the one everything is developed and judged against
#     (issue #44). It holds twenty months of watch history that no re-scan can
#     reproduce, so it is never edited in place — `admin pull-baseline` copies
#     it down and you break the copy. Host is a tailnet address, never
#     localhost, which only resolves on the box running the service.
PLEXDB_BASELINE_HOST=<tailnet-host>
PLEXDB_BASELINE_PATH=/mnt/user/appdata/plexdb/plexdb.db

# --- Where `plexdb publish` writes the read-only snapshot consumers open.
#     No default: an unset value refuses rather than guessing where readers
#     should look (ADR-0007).
PLEXDB_SNAPSHOT_PATH=./data/plexdb.snapshot.db

# --- Optional: where `plexdb init` puts the copy it takes before applying a
#     migration. Unset means a `backups/` directory beside the store, which is
#     what the container uses — the copy lands on the store's own volume, so no
#     extra mount is needed. Every copy is kept: migrations are forward-only,
#     so a copy is the only route back past its own migration.
PLEXDB_BACKUP_DIR=

# --- Deploy target: the Unraid host the container runs on. `admin deploy`
#     builds the image here for linux/amd64, ships it over ssh with
#     `docker save | docker load`, and recreates the container from the
#     [docker_run] table in admin.toml — no registry, no Unraid GUI step.
#     DEPLOY_LOCAL is empty on a workstation and `true` only in a checkout
#     that IS the Unraid host.
APP_IMAGE=plexdb:latest
UNRAID_HOST=<tailnet-host>
UNRAID_USER=root
DEPLOY_LOCAL=

# --- The container's mounts and credentials do NOT come from this file. They
#     are read over ssh from /boot/config/plexdb.env on the Unraid host, named
#     by `remote_env_file` in admin.toml, because the mount paths are
#     directories on that box and resolving them from a laptop's .env would
#     mount a laptop path onto the server. That file lives on /boot so it
#     survives a reboot, and holds:
#
#       PLEXDB_APPDATA        host dir mounted at /data      (the store itself)
#       PLEXDB_SNAPSHOT_DIR   host dir mounted at /snapshot  (what the station reads)
#       PLEXDB_EXPLORE_DATA_DIR host dir mounted at /explore-data (the Query
#                             tab's saved queries only, never the station's mount)
#       PLEX_URL, PLEX_TOKEN, PLEX_SOURCE_ROOTS
#       TAUTULLI_URL, TAUTULLI_API_KEY
#       TMDB_API_KEY, MDBLIST_API_KEY
#       LLAMA_SWAP_BASE_URL, TYPESAFE_API_KEY
#       PLEXDB_SCHEDULE, PLEXDB_TZ
#       PLEXDB_EXPLORE_BIND   optional: the one host address Plex TVX is
#       PLEXDB_EXPLORE_PORT   published on, and its port; either unset publishes
#                             nothing (it has no login)
#
#     On the host, PLEX_URL and TAUTULLI_URL are local addresses rather than
#     the tailnet ones a workstation uses.

# --- Container only: the daily run time `plexdb schedule` waits for, HH:MM in
#     24-hour time, read in the TZ the container carries (unset TZ means UTC).
#     A dev checkout never needs this — `plexdb schedule` is the container's
#     entrypoint and nothing else calls it (issue #43, ADR-0015). Unset there,
#     and set through the Unraid GUI on the host, never in a committed file.
PLEXDB_SCHEDULE=
