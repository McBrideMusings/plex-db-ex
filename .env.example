# Copy to .env and fill in. .env is gitignored and never committed.

# --- Required: the only hard dependency ---
PLEX_URL=http://<plex-host>:32400
PLEX_TOKEN=<plex-token>

# --- Required: mount roots to strip from a Plex playback path when `plexdb
#     walk` derives a path-based item_id for a title with no recognised
#     external GUID. Comma-separated. `walk` refuses to run while this is
#     empty (issue #24): without it the id is a hash of wherever the disk is
#     mounted, so it matches no other store reading the same Plex server.
#     Set it to the directory the library sections live under — ask Plex for
#     /library/sections and take the common parent of the paths it reports.
PLEX_SOURCE_ROOTS=<media-root>


# --- Required for enrichment: the core acquisition (TMDB keywords) ---
TMDB_API_KEY=<tmdb-api-key>
# Optional: a TMDB-shaped server to ask instead of https://api.themoviedb.org/3 (a caching
# proxy, or a test double). The API key is sent to it, so leave this unset in production.
# TMDB_BASE_URL=

# --- Optional: days a tmdb_keywords row stays fresh before `plexdb
#     enrich-tmdb-keywords` re-fetches it. Unset means the built-in default
#     of 45 (mid-range of the 30-60 day window docs/schema.md sets for every
#     external source).
TMDB_KEYWORDS_STALE_DAYS=

# --- Optional: days an original_language row stays fresh before `plexdb
#     enrich-tmdb-language` re-fetches it. Unset means the built-in default of 45.
TMDB_LANGUAGE_STALE_DAYS=

# --- Optional: days a tmdb_recommendations/tmdb_similar edge set stays fresh
#     before `plexdb enrich-tmdb-edges` re-fetches it. Unset means the
#     built-in default of 45, tracked separately from TMDB_KEYWORDS_STALE_DAYS.
TMDB_EDGES_STALE_DAYS=

# --- Optional: synonym keywords. `plexdb judge-keyword-pairs` embeds stored
#     keywords through llama-swap (`embeddinggemma-300m`) and asks Jev whether
#     nearby pairs mean the same thing. Either one unset and the sweep skips the
#     step. `plexdb judge-keyword-roles` asks Jev what roles each keyword plays
#     and needs only TYPESAFE_API_KEY. The container reads its real values from
#     /boot/config/plexdb.env.
LLAMA_BROKER_BASE_URL=<llama-swap-base-url>
TYPESAFE_API_KEY=<typesafe-api-key>
# --- Optional: another Jev-shaped server (a test fake or a proxy). Unset means
#     Typesafe's own endpoint.
JEV_URL=

# --- Optional: history adapter. Without these the store still runs, with no
#     abandonment signal and no IP fingerprint tier. See ADR-0004.
TAUTULLI_URL=http://<tautulli-host>:8181
TAUTULLI_API_KEY=<tautulli-api-key>

# --- Optional: Plex account ids `plexdb latent-users` treats as genuinely
#     shared by more than one person, and therefore clusters by device
#     fingerprint. Comma-separated. Every account not listed is reported as
#     one named person, however many devices it shows — device
#     fingerprinting exists only to split apart the accounts named here
#     (issue #27). Unset means the built-in default: 1,3670670
#     (McBrideMusings, bboy2448).
PLEXDB_SHARED_ACCOUNT_IDS=

# --- Optional: additional edge and membership sources ---
# TRAKT_CLIENT_ID is deliberately absent. Trakt deleted existing API
# applications without notice around 1-2 August 2026 and gated new ones behind
# a VIP subscription, so the credential cannot be obtained; issues #12, #14 and
# #36 are closed as not planned. TMDB edges and MDBList collections cover what
# Trakt would have added. Re-add the variable if that restriction lifts.
MDBLIST_API_KEY=<mdblist-api-key>

# --- Optional: days a Letterboxd list a person added stays fresh before
#     `plexdb harvest-letterboxd-lists` reads it again (one request per page of
#     100 entries and one per film, about a second each). Letterboxd needs no
#     key. Unset means the built-in default of 45.
LETTERBOXD_LISTS_STALE_DAYS=

# --- Optional: days an MDBList collection and its memberships stay fresh
#     before `plexdb harvest-mdblist` re-fetches that list. Unset means the
#     built-in default of 45, tracked separately from the TMDB knobs.
MDBLIST_STALE_DAYS=

# --- Optional: the outward list search `plexdb harvest-mdblist-search`. Days a
#     watched title stays unasked, the most titles one run searches (one MDBList
#     request each), the most candidate lists one run fetches (two or more
#     requests each), and the library titles a fetched list must hold to be
#     kept. Uses MDBLIST_API_KEY and the same daily quota. Unset means the
#     built-in defaults of 45 days, 25 titles, 10 lists and 5 titles.
MDBLIST_SEARCH_STALE_DAYS=
MDBLIST_SEARCH_MAX_SEEDS=
MDBLIST_SEARCH_MAX_LISTS=
MDBLIST_SEARCH_MIN_TITLES=

# --- Test hooks, unset everywhere else: `admin parity` points the MDBList and
#     Letterboxd clients (Python and Rust alike) at a recorded local server
#     (tools/fake_lists.py) and drops Letterboxd's one-second pause after each
#     request. Unset means api.mdblist.com, letterboxd.com and a pause of 1.
MDBLIST_BASE_URL=
LETTERBOXD_BASE_URL=
LETTERBOXD_PAUSE_SECONDS=

# --- Optional: days a title's Wikidata keywords, roles and awards stay fresh
#     before `plexdb enrich-wikidata` asks again. Wikidata needs no key. Unset
#     means the built-in default of 45.
WIKIDATA_STALE_DAYS=

# --- Optional: days an anime title's AniList tags stay fresh before
#     `plexdb enrich-anilist` asks again. AniList needs no key. Unset means the
#     built-in default of 45.
ANILIST_STALE_DAYS=

# --- Optional: days a movie's Letterboxd themes stay fresh before
#     `plexdb enrich-letterboxd` scrapes its page again, and the most movies one
#     run scrapes (two requests and about 2.5 s each). Letterboxd needs no key.
#     Unset means the built-in defaults of 45 days and 1000 movies.
LETTERBOXD_STALE_DAYS=
LETTERBOXD_MAX_TITLES=

# --- Optional: days a title's MDBList ratings stay fresh before
#     `plexdb enrich-mdblist-ratings` asks again, and the most requests one run
#     sends (200 titles each). MDBList's daily quota counts requests and
#     `harvest-mdblist` draws on the same one (1,000 a day on the free tier).
#     Uses MDBLIST_API_KEY. Unset means the built-in defaults of 45 days and
#     100 requests.
MDBLIST_RATINGS_STALE_DAYS=
MDBLIST_RATINGS_MAX_REQUESTS=

# --- Optional: an OpenAI-compatible LLM endpoint, used to pull film titles out
#     of editorial prose (issue #37). Point it at a host on the tailnet, never
#     at localhost — localhost only resolves on the box running the service.
#     LLM_API_KEY is unset for a local endpoint that doesn't check one.
LLM_BASE_URL=http://<llm-host>:<port>/v1
LLM_MODEL=<model-name>
LLM_API_KEY=

# --- Where the store lives on this machine. On a dev checkout this is a
#     working copy pulled with `admin pull-baseline`, not the baseline itself.
PLEXDB_PATH=./data/plexdb.db

# --- The baseline store: the one everything is developed and judged against
#     (issue #44). It holds twenty months of watch history that no re-scan can
#     reproduce, so it is never edited in place — `admin pull-baseline` copies
#     it down and you break the copy. Host is a tailnet address, never
#     localhost, which only resolves on the box running the service.
PLEXDB_BASELINE_HOST=<tailnet-host>
PLEXDB_BASELINE_PATH=/mnt/user/appdata/plexdb/plexdb.db

# --- Where `plexdb publish` writes the read-only snapshot consumers open.
#     No default: an unset value refuses rather than guessing where readers
#     should look (ADR-0007).
PLEXDB_SNAPSHOT_PATH=./data/plexdb.snapshot.db

# --- Optional: where `plexdb init` puts the copy it takes before applying a
#     migration. Unset means a `backups/` directory beside the store, which is
#     what the container uses — the copy lands on the store's own volume, so no
#     extra mount is needed. Every copy is kept: migrations are forward-only,
#     so a copy is the only route back past its own migration.
PLEXDB_BACKUP_DIR=

# --- Optional: the directory holding the Frame index, frames.db (ADR-0024).
#     Unset means no Frame index: every `plexdb frames` command refuses,
#     `plexdb prune-frames` is skipped in the sweep, and `plexdb check` reports
#     it as not configured. The file is derived and rebuildable, never backed up
#     or snapshotted. In the container this is /frames, mounted from
#     PLEXDB_FRAMES_HOST_DIR.
PLEXDB_FRAMES_DIR=<frames-dir>

# --- Optional: where this process sees the library directory Plex calls its
#     source root (PLEX_SOURCE_ROOTS). The frame harvester and the Search tab read
#     video files here, read-only; a part Plex reports as <root>/movies/x.mkv is
#     read at PLEXDB_MEDIA_DIR/movies/x.mkv. Unset means no frame is read: the
#     harvester refuses and the Search tab reports media as missing. In the
#     container this is /media, mounted from PLEXDB_MEDIA_HOST_DIR.
PLEXDB_MEDIA_DIR=<media-dir>

# --- Optional: the hours the frame harvester runs, HH:MM-HH:MM in 24-hour time,
#     read in the process's TZ. An end earlier than the start runs past
#     midnight. Unset means it never runs.
PLEXDB_FRAME_HOURS=<HH:MM-HH:MM>

# --- Optional: the encoder the Frame index embeds frames and phrases through
#     (ADR-0025). An OpenAI-compatible base URL — the client POSTs
#     {url}/v1/embeddings — and the model name sent in each request: a CLIP
#     ViT-L/14 checkpoint, whose 768-wide vectors are what frame_vec holds.
#     Unset means `plexdb frames probe-encoder` refuses and `plexdb frames status`
#     reports encoder_reachable as null. Check it with `plexdb frames probe-encoder`.
PLEXDB_FRAME_ENCODER_URL=<encoder-base-url>
PLEXDB_FRAME_MODEL=<clip-model-name>

# --- Optional: decode the frame harvester's video on the host's NVIDIA GPU. Both are
#     remote-env vars, read from /boot/config/plexdb.env on the host. PLEXDB_GPU is
#     the `docker run --gpus` value (`all`, a count, or `device=...`); empty hands the
#     container no GPU. PLEXDB_FRAME_DECODE=cuda makes the harvester pass ffmpeg
#     `-hwaccel cuda` to the scene scan (extraction always decodes on the CPU); unset or `cpu` decodes in software. If CUDA fails to start the
#     harvester decodes on the CPU and `plexdb frames status` shows
#     `decoder: cpu (cuda requested: <ffmpeg's last line>)`.
PLEXDB_GPU=
PLEXDB_FRAME_DECODE=

# --- Optional: `plexdb search` (ADR-0026). PLEXDB_PHRASE_CACHE is the file it keeps
#     embedded phrases in; unset means phrases.db inside PLEXDB_FRAMES_DIR.
#     PLEXDB_READ_BIN is the plexdb-read binary it runs: a path, or a name on PATH
#     (default plexdb-read). The container's image carries one; on a workstation
#     build it with `cargo build -p plexdb-reader` and point this at
#     target/debug/plexdb-read.
PLEXDB_PHRASE_CACHE=
PLEXDB_READ_BIN=

# --- The Rust writer (ADR-0001). PLEXDB_RS_BIN is the plexdb-rs binary that runs
#     the sweep steps moved from Python: a path, or a name on PATH (default
#     plexdb-rs). The container's image carries one; `admin dev` and `admin test`
#     build it and set this themselves (tools/with-rs.sh).
PLEXDB_RS_BIN=

# --- Optional: the Plex DB-EX Search tab's token boxes. PLEXDB_FRAME_TOKENIZER is a
#     tokenizer.json for PLEXDB_FRAME_MODEL; unset means the explorer reads
#     tokenizer-<model>.json from its data directory. It never downloads one; with neither
#     file, the Search tab's status names the missing path.
PLEXDB_FRAME_TOKENIZER=

# --- Optional: where the frame harvester finds ffmpeg and ffprobe. Default to the
#     names `ffmpeg` and `ffprobe` on PATH; the container image ships both.
#     `plexdb frames status` reports `ffmpeg_found`.
# PLEXDB_FFMPEG=ffmpeg
# PLEXDB_FFPROBE=ffprobe

# --- Optional: how many files `plexdb check-files` decodes end to end per run, never-decoded
#     first, then the oldest decode. Default 50; 0 turns the decode pass off.
# PLEXDB_DECODE_BATCH=50

# --- Deploy target: the Unraid host the container runs on. `admin deploy`
#     builds the image here for linux/amd64, ships it over ssh with
#     `docker save | docker load`, and recreates the container from the
#     [docker_run] table in admin.toml — no registry, no Unraid GUI step.
#     DEPLOY_LOCAL is empty on a workstation and `true` only in a checkout
#     that IS the Unraid host.
APP_IMAGE=plexdb:latest
UNRAID_HOST=<tailnet-host>
UNRAID_USER=root
DEPLOY_LOCAL=

# --- The container's mounts and credentials do NOT come from this file. They
#     are read over ssh from /boot/config/plexdb.env on the Unraid host, named
#     by `remote_env_file` in admin.toml, because the mount paths are
#     directories on that box and resolving them from a laptop's .env would
#     mount a laptop path onto the server. That file lives on /boot so it
#     survives a reboot, and holds:
#
#       PLEXDB_APPDATA        host dir mounted at /data      (the store itself)
#       PLEXDB_SNAPSHOT_DIR   host dir mounted at /snapshot  (what the station reads)
#       PLEXDB_EXPLORE_DATA_DIR host dir mounted at /explore-data (Plex DB-EX's
#                             saved queries, decision files, tokenizer and clips
#                             cache; a subfolder of PLEXDB_APPDATA that the
#                             store's backups never copy, never the station's mount)
#       PLEXDB_FRAMES_HOST_DIR host dir mounted at /frames (the Frame index,
#                             frames.db; a subfolder of PLEXDB_APPDATA,
#                             which the store's backups never copy)
#       PLEXDB_MEDIA_HOST_DIR host dir mounted read-only at /media (the video
#                             library, the directory Plex's own container
#                             mounts at PLEX_SOURCE_ROOTS)
#       PLEXDB_FRAME_HOURS, PLEXDB_FRAME_ENCODER_URL, PLEXDB_FRAME_MODEL
#       PLEX_URL, PLEX_TOKEN, PLEX_SOURCE_ROOTS
#       TAUTULLI_URL, TAUTULLI_API_KEY
#       TMDB_API_KEY, MDBLIST_API_KEY
#       LLAMA_BROKER_BASE_URL, TYPESAFE_API_KEY
#       PLEXDB_SCHEDULE, PLEXDB_TZ
#       PLEXDB_EXPLORE_BIND   optional: the one host address Plex DB-EX is
#       PLEXDB_EXPLORE_PORT   published on, and its port; either unset publishes
#                             nothing (it has no login)
#
#     On the host, PLEX_URL and TAUTULLI_URL are local addresses rather than
#     the tailnet ones a workstation uses.

# --- Container only: the daily run time `plexdb schedule` waits for, HH:MM in
#     24-hour time, read in the TZ the container carries (unset TZ means UTC).
#     A dev checkout never needs this — `plexdb schedule` is the container's
#     entrypoint and nothing else calls it (issue #43, ADR-0015). Unset there,
#     and set through the Unraid GUI on the host, never in a committed file.
PLEXDB_SCHEDULE=
